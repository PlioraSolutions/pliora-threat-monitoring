# ==============================================================================
# PLIŌRA Threat Monitor — Environment Variables Template
# ==============================================================================

# Node Environment
NODE_ENV=production

# Database (MongoDB Atlas recommended for production)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxx.mongodb.net/pliora_threat_monitor?retryWrites=true&w=majority

# Redis (Upstash Redis or standard Redis; fallback active if omitted)
REDIS_URL=redis://localhost:6379
ENABLE_IN_MEMORY_QUEUE_FALLBACK=true

# Authentication & Session Security (Required: Generate 32+ char random strings)
NEXTAUTH_SECRET=generate_a_random_32_character_secret_for_production
JWT_SECRET=generate_another_random_32_character_secret_for_jwt

# In-Memory Store Override (Set to 'true' only for demo/preview without MongoDB)
ALLOW_IN_MEMORY_STORE=false

# Scanner Worker Settings
SCAN_WORKER_CONCURRENCY=5

# AI Security Analyst (Gemini or OpenAI)
AI_PROVIDER=gemini
AI_MODEL=gemini-1.5-flash
GEMINI_API_KEY=your_google_gemini_api_key
# OPENAI_API_KEY=your_openai_api_key

# Stripe Billing (Test mode or Live mode)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_STARTER_MONTHLY=price_...
STRIPE_PRICE_BUSINESS_MONTHLY=price_...
STRIPE_PRICE_PRO_MONTHLY=price_...

# Third-party Integrations (Optional)
# HIBP_API_KEY=
# VIRUSTOTAL_API_KEY=
# GITHUB_TOKEN=
# ERROR_TRACKING_WEBHOOK_URL=

# Data Retention Policies (in days)
EVIDENCE_RETENTION_DAYS=90
CANCELLED_ORG_RETENTION_DAYS=30
